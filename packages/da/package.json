{
  "name": "@johnhenry/raijin-da",
  "version": "0.0.2",
  "description": "Data availability abstraction with pluggable backends for the Raijin mesh rollup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/raijin.git",
    "directory": "packages/da"
  },
  "homepage": "https://github.com/johnhenry/raijin#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run && npm run test:node",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:node": "node --test test/default-inflate.node.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@johnhenry/raijin-core": "^0.0.1"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  },
  "optionalDependencies": {
    "fflate": "^0.8.3"
  }
}
